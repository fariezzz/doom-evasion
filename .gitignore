# Virtual environment
.venv/
venv/

# Python
__pycache__/
*.py[cod]
*.egg-info/

# ViZDoom generated config (local paths, regenerable)
_vizdoom.ini

# Dataset frames: regenerable by re-running the collect scripts with the
# same seeds. Manifests, split CSVs, and summaries in the data folders
# ARE tracked, only the PNG frames are ignored.
data_*/**/*.png

# Training checkpoints: regenerable by re-running train_baseline.py.
runs/**/*.pt

# Gameplay frame captures are regenerable and should not be pushed.
runs/**/frame_*.png

# Smoke test outputs: throwaway verification runs, not results.
runs/smoke/

# FGSM attack outputs: generated results, shared via handoff zip, not git.
# The attack script itself (attack_fgsm.py) IS tracked.
runs/fgsm/
runs/fgsm_smoke/

# MNIST practice data and outputs: practice material, not project results.
# The practice script itself (mnist_latihan.py) is NOT ignored.
data_mnist/
runs/mnist_latihan*/

# Editor
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db